# Puerto del servidor local
PORT=3001

# Namespace de logs (debug)
DEBUG=invoke:*

# Región de AWS
AWS_REGION=us-east-1

# ARN de la Step Function que ejecuta el análisis de código fuente.
ANALYSIS_STATE_MACHINE_ARN=arn:aws:states:us-east-1:000000000000:stateMachine:source-trace-analysis

# Bucket S3 donde el front sube el artefacto con la URL prefirmada.
UPLOAD_BUCKET=source-trace-uploads
# Prefijo/carpeta bajo el que se guardan los archivos (opcional).
UPLOAD_PREFIX=uploads
# Validez de la URL prefirmada en segundos (opcional, default 900).
UPLOAD_URL_EXPIRES_SECONDS=900
